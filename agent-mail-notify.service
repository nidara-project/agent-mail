# A desktop notification for every agent-mail message.
#   cp agent-mail-notify.service ~/.config/systemd/user/
#   systemctl --user enable --now agent-mail-notify
[Unit]
Description=agent-mail: desktop notifications for new messages
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=%h/.local/bin/agent-mail notify
Restart=on-failure

[Install]
WantedBy=graphical-session.target
